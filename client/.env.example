# Stripe publishable key
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# ZegoCloud video calls (https://console.zegocloud.com). generateKitTokenForTest is a dev-only helper;
# production should mint kit tokens on the server so the secret never ships to browsers.
VITE_ZEGO_APP_ID=
VITE_ZEGO_SERVER_SECRET=
